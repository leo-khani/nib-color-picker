{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nib Color Picker",
  "version": "0.1.0",
  "identifier": "com.nib.colorpicker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nib Color Picker",
        "width": 420,
        "height": 610,
        "minWidth": 360,
        "minHeight": 92,
        "maxWidth": 420,
        "maxHeight": 1200,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "shortDescription": "Fast, private Windows color picker",
    "longDescription": "Pick colors from anywhere on Windows, copy common formats, and keep a private local history.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
